{
  "type": "object",
  "properties": {
    "spec": {
      "type": "object",
      "properties": {
        "schema": {
          "enum": [
            "draftwright.spec/1",
            "draftwright.spec/2"
          ]
        },
        "part": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "binding": {
          "type": [
            "object",
            "null"
          ]
        },
        "sheet": {
          "$ref": "#/A"
        },
        "balloons": {
          "$ref": "#/A"
        },
        "iso_scale_factor": {
          "type": [
            "number",
            "null"
          ]
        },
        "sheets": {
          "type": [
            "object",
            "null"
          ]
        },
        "views": {
          "$ref": "#/A"
        },
        "dimensions": {
          "$ref": "#/A"
        },
        "annotations": {
          "$ref": "#/A"
        },
        "features": {
          "$ref": "#/A"
        },
        "faces": {
          "$ref": "#/A"
        },
        "dimension_schemes": {
          "$ref": "#/A"
        },
        "precision": {
          "$ref": "#/A"
        },
        "dimension_source": {
          "enum": [
            "auto",
            "authored"
          ]
        },
        "pmi": {
          "enum": [
            "strict",
            "first",
            "ignore"
          ]
        },
        "origin": {
          "$ref": "#/A"
        },
        "hole_table": {
          "enum": [
            "auto",
            "always",
            "never"
          ]
        },
        "envelope_tolerance": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array"
        },
        "tables": {
          "type": "array"
        },
        "gears": {
          "type": "array"
        },
        "feature_declarations": {
          "type": "array"
        }
      },
      "additionalProperties": false,
      "description": "Typed outline only. Call spec_schema {} for the full Spec and get_spec spec_read schemas; item_options gives valid edit paths and choices."
    },
    "part": {
      "type": "integer",
      "minimum": 0
    },
    "detail": {
      "type": "boolean"
    },
    "problem_filter": {
      "type": "object",
      "properties": {
        "severity": {
          "enum": [
            null,
            "info",
            "warning",
            "error"
          ]
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(code|subject|feature)$(?!\n)": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "step"
      ]
    },
    {
      "required": [
        "part_ref"
      ]
    }
  ],
  "patternProperties": {
    "^(spec_version|step|features|(part|drawing)_ref)$(?!\n)": {
      "type": "string"
    }
  },
  "A": {
    "type": "object"
  }
}
