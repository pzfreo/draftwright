{
  "type": "object",
  "properties": {
    "part_ref": {
      "type": "string"
    },
    "spec": {
      "type": "object",
      "properties": {
        "schema": {
          "enum": [
            "draftwright.spec/1",
            "draftwright.spec/2"
          ]
        },
        "part": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "binding": {
          "type": [
            "object",
            "null"
          ]
        },
        "sheet": {
          "$ref": "#/A"
        },
        "balloons": {
          "$ref": "#/A"
        },
        "iso_scale_factor": {
          "type": [
            "number",
            "null"
          ]
        },
        "sheets": {
          "type": [
            "object",
            "null"
          ]
        },
        "views": {
          "$ref": "#/A"
        },
        "dimensions": {
          "$ref": "#/A"
        },
        "annotations": {
          "$ref": "#/A"
        },
        "features": {
          "$ref": "#/A"
        },
        "faces": {
          "$ref": "#/A"
        },
        "dimension_schemes": {
          "$ref": "#/A"
        },
        "precision": {
          "$ref": "#/A"
        },
        "dimension_source": {
          "enum": [
            "auto",
            "authored"
          ]
        },
        "pmi": {
          "enum": [
            "strict",
            "first",
            "ignore"
          ]
        },
        "origin": {
          "$ref": "#/A"
        },
        "hole_table": {
          "enum": [
            "auto",
            "always",
            "never"
          ]
        },
        "envelope_tolerance": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array"
        },
        "tables": {
          "type": "array"
        },
        "gears": {
          "type": "array"
        },
        "feature_declarations": {
          "type": "array"
        }
      },
      "additionalProperties": false,
      "description": "Typed outline only. Call spec_schema {} for the full Spec and get_spec spec_read schemas; item_options gives valid edit paths and choices."
    },
    "spec_version": {
      "type": "string"
    },
    "drawing_ref": {
      "type": "string"
    },
    "cursor": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "detail": {
      "type": "boolean"
    },
    "filter": {
      "type": "object",
      "properties": {
        "sheet": {
          "enum": [
            null,
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8,
            9
          ]
        },
        "state": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "enum": [
                    {
                      "kind": "shown"
                    },
                    {
                      "kind": "omitted_by_user"
                    },
                    {
                      "kind": "not_authored"
                    }
                  ]
                },
                {
                  "properties": {
                    "kind": {
                      "const": "covered"
                    },
                    "by": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "minProperties": 2
                },
                {
                  "properties": {
                    "kind": {
                      "const": "not_drawable"
                    },
                    "reason_code": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "minProperties": 2
                }
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "region": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "radius": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(view|kind|feature|near)$(?!\n)": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "required": [
    "part_ref"
  ],
  "additionalProperties": false,
  "A": {
    "type": "object"
  }
}
