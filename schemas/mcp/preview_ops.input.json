{
  "type": "object",
  "properties": {
    "part_ref": {
      "type": "string"
    },
    "spec": {
      "type": "object",
      "properties": {
        "schema": {
          "enum": [
            "draftwright.spec/1",
            "draftwright.spec/2",
            "draftwright.spec/3"
          ]
        },
        "part": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "iso_scale_factor": {
          "type": [
            "number",
            "null"
          ]
        },
        "dimension_source": {
          "enum": [
            "auto",
            "authored"
          ]
        },
        "pmi": {
          "enum": [
            "strict",
            "first",
            "ignore"
          ]
        },
        "hole_table": {
          "enum": [
            "auto",
            "always",
            "never"
          ]
        }
      },
      "additionalProperties": false,
      "description": "Outline. Call spec_schema {} for the full Spec and get_spec spec_read schemas; item_options gives valid edit paths and choices.",
      "patternProperties": {
        "^(sheet|balloons|views|dimensions|annotations|features|faces|dimension_schemes|precision|origin)$(?!\n)": {
          "type": "object"
        },
        "^(process|envelope_tolerance)$(?!\n)": {
          "type": [
            "string",
            "null"
          ]
        },
        "^(notes|tables|gears|feature_declarations)$(?!\n)": {
          "type": "array"
        },
        "^(binding|sheets)$(?!\n)": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "spec_version": {
      "type": "string"
    },
    "drawing_ref": {
      "type": "string"
    },
    "cursor": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "detail": {
      "type": "boolean"
    },
    "ops": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "properties": {
              "op": {
                "enum": [
                  "set",
                  "add"
                ]
              },
              "path": {
                "type": "string"
              },
              "value": {}
            },
            "additionalProperties": false,
            "minProperties": 3
          },
          {
            "properties": {
              "op": {
                "const": "remove"
              },
              "path": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "minProperties": 2
          }
        ],
        "type": "object"
      },
      "maxItems": 32
    }
  },
  "required": [
    "part_ref",
    "ops"
  ],
  "additionalProperties": false
}
