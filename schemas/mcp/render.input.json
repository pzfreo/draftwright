{
  "type": "object",
  "properties": {
    "spec": {
      "type": "object",
      "properties": {
        "schema": {
          "enum": [
            "draftwright.spec/1",
            "draftwright.spec/2",
            "draftwright.spec/3"
          ]
        },
        "part": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "iso_scale_factor": {
          "type": [
            "number",
            "null"
          ]
        },
        "dimension_source": {
          "enum": [
            "auto",
            "authored"
          ]
        },
        "pmi": {
          "enum": [
            "strict",
            "first",
            "ignore"
          ]
        },
        "hole_table": {
          "enum": [
            "auto",
            "always",
            "never"
          ]
        }
      },
      "additionalProperties": false,
      "description": "Outline. Call spec_schema {} for the full Spec and get_spec spec_read schemas; item_options gives valid edit paths and choices.",
      "patternProperties": {
        "^(sheet|balloons|views|dimensions|annotations|features|faces|dimension_schemes|precision|origin)$(?!\n)": {
          "type": "object"
        },
        "^(process|envelope_tolerance)$(?!\n)": {
          "type": [
            "string",
            "null"
          ]
        },
        "^(notes|tables|gears|feature_declarations)$(?!\n)": {
          "type": "array"
        },
        "^(binding|sheets)$(?!\n)": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "part": {
      "type": "integer",
      "minimum": 0
    },
    "format": {
      "enum": [
        "png",
        "pdf"
      ]
    },
    "region": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "overlay_ids": {
      "type": [
        "boolean",
        "array"
      ],
      "items": {
        "type": "string"
      }
    },
    "sheet": {
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8,
        9
      ]
    },
    "dpi": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 400
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "step"
      ]
    },
    {
      "required": [
        "part_ref"
      ]
    }
  ],
  "patternProperties": {
    "^(spec_version|step|features|(part|drawing)_ref)$(?!\n)": {
      "type": "string"
    }
  }
}
