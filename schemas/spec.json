{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draftwright Spec",
  "description": "Author Spec structure. Absent fields use defaults. Geometry, references, engineering constraints and edit guidance are validated by the server. The get_spec spec value has the same shape, also named by #/$defs/spec_read.",
  "type": "object",
  "properties": {
    "schema": {
      "enum": [
        "draftwright.spec/1",
        "draftwright.spec/2"
      ]
    },
    "part": {
      "description": "Part identity from draftwright parts: persistent key (preferred) or numeric index. Acts like --part; conflicting command/request selectors are refused. A saved Analysis must already contain this part.",
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "sheet": {
      "$ref": "#/$defs/sheet"
    },
    "balloons": {
      "$ref": "#/$defs/balloon_settings"
    },
    "iso_scale_factor": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "sheets": {
      "anyOf": [
        {
          "$ref": "#/$defs/sheets"
        },
        {
          "type": "null"
        }
      ]
    },
    "dimension_source": {
      "enum": [
        "auto",
        "authored"
      ]
    },
    "pmi": {
      "enum": [
        "strict",
        "first",
        "ignore"
      ]
    },
    "origin": {
      "description": "Datum stations: min, max, a unique normal plane or axis:<reference> transverse to the named coordinate.",
      "type": "object",
      "properties": {
        "x": {
          "type": "string"
        },
        "y": {
          "type": "string"
        },
        "z": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "hole_table": {
      "enum": [
        "auto",
        "always",
        "never"
      ]
    },
    "envelope_tolerance": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "precision": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 15
      }
    },
    "views": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/view"
      },
      "properties": {
        "sections": {
          "description": "Explicit longitudinal sections through named geometry. Unavailable planes retain the drawing with a specific warning.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-H]$"
              },
              "through": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "through"
            ]
          }
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/dimension"
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/annotation"
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/feature"
      }
    },
    "faces": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/face"
      }
    },
    "dimension_schemes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/scheme"
      }
    },
    "feature_declarations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/declaration"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table"
      }
    },
    "gears": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gear"
      }
    },
    "process": {
      "description": "Per-part process. Overrides file specify process UDA and material-class guess. Printed defaults are marked CHECK; override tolerance at sheet/title/tolerance and finish at sheet/default_finish.",
      "enum": [
        "machined",
        "3D printed: FDM",
        "3D printed: resin",
        "3D printed: powder",
        "3D printed: metal",
        "sheet metal",
        "moulded",
        "cast",
        null
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "binding": {
      "type": "object",
      "properties": {
        "source_sha256": {
          "type": "string"
        },
        "part": {
          "type": "string"
        },
        "face_count": {
          "type": "integer",
          "minimum": 0
        },
        "loader": {
          "type": "string"
        },
        "part_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "part",
        "face_count",
        "loader"
      ]
    },
    "callouts": {
      "type": "object",
      "properties": {
        "style": {
          "enum": [
            "auto",
            "compact",
            "full",
            "note"
          ]
        }
      },
      "additionalProperties": false
    },
    "text": {
      "type": "object",
      "properties": {
        "prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "suffix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "place": {
      "type": "object",
      "properties": {
        "view": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "side": {
          "anyOf": [
            {
              "enum": [
                "above",
                "below",
                "left",
                "right"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "lane": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "along": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "enum": [
                    "start",
                    "middle",
                    "end",
                    "outside"
                  ]
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "offset": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "pinned": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "view_place": {
      "type": "object",
      "properties": {
        "relative_to": {
          "type": "string"
        },
        "side": {
          "enum": [
            "above",
            "below",
            "left",
            "right"
          ]
        },
        "gap": {
          "type": "number",
          "description": "Clear paper distance in mm between the views\u2019 annotation bands, not their part outlines (default 10 mm)."
        },
        "align": {
          "enum": [
            "start",
            "middle",
            "end",
            "outside",
            "projection"
          ],
          "description": "projection keeps geometry origins aligned across side (x above/below, y left/right), only for front/plan or front/side in either direction, first or third angle. Gap stays between areas including bands. Other values retain existing alignment."
        },
        "pinned": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "relative_to",
        "side"
      ]
    },
    "finish": {
      "type": "object",
      "properties": {
        "ra": {
          "type": "number"
        },
        "removal": {
          "anyOf": [
            {
              "enum": [
                "any",
                "required",
                "prohibited"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "ra"
      ]
    },
    "modelled_thread": {
      "type": "object",
      "properties": {
        "depiction": {
          "anyOf": [
            {
              "type": "boolean",
              "description": "Use ISO 6410 conventional ink to depict thread extent; false restores modelled edges."
            },
            {
              "type": "null"
            }
          ]
        },
        "designation": {
          "anyOf": [
            {
              "type": "string",
              "description": "Replace the entire modelled-thread callout verbatim. Default: ISO designation, or measured diameter and pitch; no length suffix."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "thread": {
      "type": "object",
      "properties": {
        "designation": {
          "type": "string"
        },
        "length": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "designation"
      ]
    },
    "knurl": {
      "type": "object",
      "properties": {
        "pattern": {
          "enum": [
            "straight",
            "diamond"
          ]
        },
        "pitch": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "required": [
        "pattern",
        "pitch"
      ]
    },
    "control": {
      "type": "object",
      "properties": {
        "characteristic": {
          "enum": [
            "straightness",
            "flatness",
            "circularity",
            "cylindricity",
            "profile_line",
            "profile_surface",
            "angularity",
            "perpendicularity",
            "parallelism",
            "position",
            "concentricity",
            "symmetry",
            "circular_runout",
            "total_runout"
          ]
        },
        "tolerance": {
          "type": "number"
        },
        "datums": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diameter": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "modifier": {
          "anyOf": [
            {
              "enum": [
                "M",
                "L"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "characteristic",
        "tolerance"
      ]
    },
    "anchor": {
      "type": "object",
      "properties": {
        "faces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "faces"
      ]
    },
    "pattern": {
      "type": "object",
      "properties": {
        "arrangement": {
          "enum": [
            "linear",
            "grid",
            "bolt_circle"
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "arrangement",
        "members"
      ]
    },
    "declaration": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "hole",
            "boss",
            "turned_step",
            "slot",
            "pocket"
          ]
        },
        "faces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "faces"
      ]
    },
    "scheme": {
      "type": "object",
      "properties": {
        "scheme": {
          "enum": [
            "chain",
            "baseline",
            "ordinate"
          ]
        },
        "axis": {
          "enum": [
            "x",
            "y",
            "z"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "view": {
          "anyOf": [
            {
              "enum": [
                "front",
                "plan",
                "side"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "scheme",
        "axis"
      ]
    },
    "dimension": {
      "type": "object",
      "properties": {
        "presentation": {
          "anyOf": [
            {
              "enum": [
                "tangent_depth",
                "far_extreme"
              ],
              "description": "Cylindrical-mouth pocket depth: tangent_depth measures from the near tangent; far_extreme states the floor distance from the opposite cylinder tangent. Both are measured from the cylinder axis, radius and pocket floor. Measured values are retained; unsupported requests warn."
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "style": {
          "anyOf": [
            {
              "enum": [
                "reference",
                "basic"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "diameter",
                "radius",
                "angle"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "between": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "along": {
          "anyOf": [
            {
              "enum": [
                "x",
                "y",
                "z",
                "true"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "tolerance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fit": {
          "description": "ISO 286 fit class. Prints independently of the supported numerical-deviation table; unavailable requested deviations warn without invented values.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "view": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "place": {
          "anyOf": [
            {
              "$ref": "#/$defs/place"
            },
            {
              "type": "null"
            }
          ]
        },
        "omit": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "properties": {
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "place": {
          "anyOf": [
            {
              "$ref": "#/$defs/place"
            },
            {
              "type": "null"
            }
          ]
        },
        "omit": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "feature": {
      "type": "object",
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/anchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "reclassify": {
          "anyOf": [
            {
              "enum": [
                "hole",
                "boss",
                "turned_step",
                "slot",
                "pocket"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "gusset_view": {
          "anyOf": [
            {
              "enum": [
                "front",
                "side",
                "plan"
              ],
              "description": "Transverse view for a readable gusset group; must look along either leg. Legs remain in the triangle view."
            },
            {
              "type": "null"
            }
          ]
        },
        "pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/pattern"
            },
            {
              "type": "null"
            }
          ]
        },
        "fit": {
          "description": "ISO 286 fit class. Prints independently of the supported numerical-deviation table; unavailable requested deviations warn without invented values.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "datum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "finish": {
          "anyOf": [
            {
              "$ref": "#/$defs/finish"
            },
            {
              "type": "null"
            }
          ]
        },
        "modelled_thread": {
          "anyOf": [
            {
              "$ref": "#/$defs/modelled_thread"
            },
            {
              "type": "null"
            }
          ]
        },
        "spring": {
          "anyOf": [
            {
              "enum": [
                "simplified",
                "full"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "thread": {
          "anyOf": [
            {
              "$ref": "#/$defs/thread"
            },
            {
              "type": "null"
            }
          ]
        },
        "knurl": {
          "anyOf": [
            {
              "$ref": "#/$defs/knurl"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "callouts": {
          "anyOf": [
            {
              "$ref": "#/$defs/callouts"
            },
            {
              "type": "null"
            }
          ]
        },
        "suppress": {
          "type": "boolean"
        },
        "split": {
          "type": "boolean"
        },
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/control"
          }
        },
        "note_satisfies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "face": {
      "type": "object",
      "properties": {
        "datum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "finish": {
          "anyOf": [
            {
              "$ref": "#/$defs/finish"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile_corners": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "angle",
                "linear"
              ],
              "description": "How the corners of this face\u2019s outer profile are defined: auto (default) calls out a 45\u00b0 corner chamfer by its size (C<leg>, counted when equal), locates any other cut corner\u2019s missing stations with linear dimensions, gives any other non-right corner its angle and a regular polygon one counted angle; angle states every corner\u2019s angle (a reference where linear dimensions already fix it) instead of stations; linear locates the stations of every corner, a regular polygon\u2019s too. Per corner, dimensions/<id> {} shows and omit hides an angle."
            },
            {
              "type": "null"
            }
          ]
        },
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/control"
          }
        }
      },
      "additionalProperties": false
    },
    "sheet": {
      "type": "object",
      "properties": {
        "balloons": {
          "enum": [
            "off",
            "all"
          ]
        },
        "hidden": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "centre_marks": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "centre_lines": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "thread_depiction": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "knurl_depiction": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "keep_layout": {
          "anyOf": [
            {
              "type": "boolean",
              "description": "Keep explicit paper, scale and sheet count without automatic selection or view refitting. Requires sheet.size, sheet.scale and sheets.max=1. Moved views are reported on apply. A later explicit paper, scale or sheet-count edit releases an inherited guard; explicitly setting keep_layout in the same batch retains it. Remove to allow the whole sheet to be laid out again, including hand-moved placements."
            },
            {
              "type": "null"
            }
          ]
        },
        "uncited_datums": {
          "anyOf": [
            {
              "type": "boolean",
              "description": "Draw every declared datum by default; false hides symbols no control frame cites, recorded as omitted_by_user. Individual symbols use annotations/<id>/omit."
            },
            {
              "type": "null"
            }
          ]
        },
        "zones": {
          "anyOf": [
            {
              "type": "boolean",
              "description": "ISO 5457 grid zones and centring marks on every sheet (default true). false omits both, except zones cited by section cross-references, which stay with a sheet_zones_kept info finding."
            },
            {
              "type": "null"
            }
          ]
        },
        "view_gutter": {
          "anyOf": [
