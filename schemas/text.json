{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draftwright rendered text inventory",
  "type": "object",
  "required": ["schema", "origin", "y_axis", "sheets", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "draftwright.text/1"},
    "origin": {"const": "top-left"},
    "y_axis": {"const": "down"},
    "sheets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "size_mm"],
        "additionalProperties": false,
        "properties": {
          "number": {"$ref": "#/$defs/sheet_number"},
          "size_mm": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 2, "maxItems": 2}
        }
      }
    },
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "sheet_number": {"type": "integer", "minimum": 1},
    "index": {"type": "integer", "minimum": 0},
    "box": {
      "description": "Axis-aligned ink bounds [left, top, right, bottom] in the sheet's top-left coordinate system.",
      "type": "array",
      "items": {"type": "number"},
      "minItems": 4,
      "maxItems": 4
    },
    "entry": {
      "type": "object",
      "required": ["id", "type", "text", "sheet", "bbox_mm", "bbox_pt", "rotation"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "description": "The plan item ID when available. Several printed runs may belong to the same item."},
        "type": {"enum": ["dimension", "annotation", "hole_tag", "balloon", "table_cell", "note", "title_block", "caption", "view_label", "zone", "scale"]},
        "text": {"type": "string"},
        "sheet": {"$ref": "#/$defs/sheet_number"},
        "bbox_mm": {"$ref": "#/$defs/box"},
        "bbox_pt": {"$ref": "#/$defs/box"},
        "rotation": {"type": "number", "description": "Clockwise degrees."},
        "svg_text_index": {"$ref": "#/$defs/index", "description": "Index of the corresponding SVG text element on this sheet. Omitted for outline-only labels."},
        "view": {"type": "string"},
        "features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "model_value": {"type": "number", "description": "The leading model measurement in millimetres or degrees."},
        "table_id": {"type": "string"},
        "block": {"$ref": "#/$defs/index", "description": "The table's zero-based block on this sheet. Unsplit tables use block 0."},
        "row": {"$ref": "#/$defs/index"},
        "column": {"$ref": "#/$defs/index"},
        "field": {"type": "string"},
        "is_label": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "dimension"}}}, "then": {"required": ["view", "features", "model_value"]}},
        {"if": {"properties": {"type": {"const": "table_cell"}}}, "then": {"required": ["table_id", "block", "row", "column"]}},
        {"if": {"properties": {"type": {"const": "title_block"}}}, "then": {"required": ["field", "is_label"]}}
      ]
    }
  }
}
