#!/usr/bin/env python3
"""Build a fixed-sheet baseline/candidate pair and enforce semantic content parity."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from collections import Counter
from dataclasses import replace
from importlib import import_module
from pathlib import Path

_ROOT = Path(__file__).resolve().parents[1]
_SRC = _ROOT / "src"
_CAP_REPORT = {}
if str(_SRC) not in sys.path:
    sys.path.insert(0, str(_SRC))


def _python() -> str:
    candidate = _ROOT / ".venv" / "bin" / "python"
    return str(candidate if candidate.is_file() else Path(sys.executable))


def _cap_scheme_strips(scale: float, enabled_routes: set[tuple[str, str]]) -> None:
    analysis = import_module("draftwright.analysis")
    legacy_measure = analysis._measure_strips

    def measured(*args, **kwargs):
        strips = legacy_measure(*args, **kwargs)
        planned = strips.planned_corridor_depths(scale)

        def cap(current, *routes):
            if not any(route in enabled_routes for route in routes):
                return current
            values = [planned[route] for route in routes if route in planned]
            return min(current, max(values)) if current > 0 and values else current

        capped = replace(
            strips,
            right=cap(strips.right, ("front", "right"), ("plan", "right")),
            left=cap(strips.left, ("front", "left"), ("plan", "left")),
            top=cap(strips.top, ("plan", "above")),
            fv_top=cap(strips.fv_top, ("front", "above")),
            fv_bottom=cap(strips.fv_bottom, ("front", "below")),
            pv_authored_top=cap(strips.pv_authored_top, ("plan", "above")),
            pv_bottom=cap(strips.pv_bottom, ("plan", "below")),
            sv_top=cap(strips.sv_top, ("side", "above")),
            sv_bottom=cap(strips.sv_bottom, ("side", "below")),
            sv_right=cap(strips.sv_right, ("side", "right")),
            rv_right=cap(strips.rv_right, ("rear", "right")),
        )
        _CAP_REPORT.update(
            {
                "before": {
                    name: getattr(strips, name)
                    for name in (
                        "right",
                        "left",
                        "top",
                        "fv_top",
                        "fv_bottom",
                        "pv_authored_top",
                        "pv_bottom",
                        "sv_top",
                        "sv_bottom",
                        "sv_right",
                        "rv_right",
                    )
                },
                "after": {
                    name: getattr(capped, name)
                    for name in (
                        "right",
                        "left",
                        "top",
                        "fv_top",
                        "fv_bottom",
                        "pv_authored_top",
                        "pv_bottom",
                        "sv_top",
                        "sv_bottom",
                        "sv_right",
                        "rv_right",
                    )
                },
                "planned": {f"{view}/{side}": depth for (view, side), depth in planned.items()},
            }
        )
        return capped

    analysis._measure_strips = measured


def _manifest(drawing) -> dict:
    from draftwright.builder import (
        _arrangement_quality,
        _blocker_identity,
        _scale_blockers_from_issues,
    )

    model = drawing.model()
    feature_indices = {id(feature): index for index, feature in enumerate(model.features)}

    def feature_identity(feature) -> dict:
        index = feature_indices.get(id(feature))
        if index is None:
            matches = [
                candidate_index
                for candidate_index, candidate in enumerate(model.features)
                if candidate == feature
            ]
            index = matches[0] if len(matches) == 1 else None
        return {
            "feature_index": index,
            "kind": str(getattr(feature, "kind", type(feature).__name__)),
            "source_id": str(
                getattr(feature, "source_id", "")
                or next(iter(getattr(feature, "source_ids", ())), "")
            ),
        }

    def requirement_identities(identities) -> list[dict]:
        values = [
            {
                "feature": feature_identity(identity.feature),
                "parameter": str(identity.parameter),
            }
            for identity in identities
        ]
        return sorted(values, key=lambda value: json.dumps(value, sort_keys=True))

    annotations = {}
    for name, annotation in drawing.iter_annotations():
        annotations[name] = {
            "type": type(annotation).__name__,
            "label": str(getattr(annotation, "label", "")),
            "view": drawing.view_of(name),
            "region": getattr(annotation, "_dw_candidate_region", None),
            "measurements": requirement_identities(drawing.registry.measurement_of(name)),
            "satisfactions": requirement_identities(drawing.registry.satisfaction_of(name)),
            "owners": sorted(
                (feature_identity(feature) for feature in drawing.registry.features_of(name)),
                key=lambda value: json.dumps(value, sort_keys=True),
            ),
        }
    issues = tuple(drawing.lint())
    blockers = _scale_blockers_from_issues(issues)
    lint = drawing.lint_summary()
    completeness = lint["quality"]["completeness"]
    drops = {
        code: count
        for code, count in lint["by_code"].items()
        if "drop" in code or "withheld" in code or code == "placement_unsatisfiable"
    }
    interior_dimensions = sorted(
        name
        for name, annotation in drawing.iter_annotations()
        if "Dimension" in type(annotation).__name__
        and getattr(annotation, "_dw_candidate_region", None) == "interior"
    )
    return {
        "annotations": annotations,
        "interior_dimensions": interior_dimensions,
        "arrangement_quality": _arrangement_quality(
            issues,
            blockers,
            page=(drawing.page_w, drawing.page_h),
            scale=drawing.scale,
            interior_dimensions=len(interior_dimensions),
        ),
        "blocker_identities": sorted(_blocker_identity(blocker) for blocker in blockers),
        "coverage": {
            key: completeness.get(key)
            for key in ("requirements", "placed", "missing", "unverifiable", "unsupported")
        },
        "drops": drops,
        "lint": {"errors": lint["errors"], "warnings": lint["warnings"]},
    }


def _worker(args) -> int:
    if args.mode == "candidate":
        _cap_scheme_strips(args.scale, _parse_routes(args.candidate_routes))
        if args.arrangement is not None:
            os.environ["DRAFTWRIGHT_EXPERIMENTAL_ARRANGEMENT"] = args.arrangement
        if args.exterior_dimensions:
            os.environ["DRAFTWRIGHT_EXPERIMENTAL_EXTERIOR_DIMENSIONS"] = "1"
    from draftwright import build_drawing

    output = Path(args.output)
    drawing = build_drawing(
        Path(args.source),
        out=str(output),
        title=args.title,
        number=args.number,
        pmi="annotate",
        page=args.page,
        scale=args.scale,
        scale_policy="permissive",
        _views=("front", "plan", "side"),
        _include_iso=True,
    )
    paths = drawing.export(str(output), formats=tuple(args.formats.split(",")))
    print(
        json.dumps(
            {
                "mode": args.mode,
                "paths": {key: str(value) for key, value in paths.items()},
                "page": [drawing.page_w, drawing.page_h],
                "scale": drawing.scale,
                "views": list(drawing.views),
                "corridor_depths": _CAP_REPORT,
                "manifest": _manifest(drawing),
            },
            sort_keys=True,
        )
    )
    return 0


def _run_worker(args, mode: str, output: Path, *, candidate_routes: str | None = None) -> dict:
    command = [
        _python(),
        str(Path(__file__).resolve()),
        "--worker",
        "--mode",
        mode,
        "--source",
        str(args.source),
        "--output",
        str(output),
        "--page",
        args.page,
        "--scale",
        str(args.scale),
        "--title",
        args.title,
        "--number",
        args.number,
        "--formats",
        args.formats,
        "--candidate-routes",
        args.candidate_routes if candidate_routes is None else candidate_routes,
    ]
    if args.arrangement is not None:
        command.extend(("--arrangement", args.arrangement))
    if args.exterior_dimensions:
        command.append("--exterior-dimensions")
    completed = subprocess.run(command, check=False, capture_output=True, text=True)
    if completed.returncode:
        raise RuntimeError(f"{mode} build failed:\n{completed.stderr}")
    return json.loads(completed.stdout)


def _compare(baseline: dict, candidate: dict) -> dict:
    before = baseline["manifest"]
    after = candidate["manifest"]
    before_annotations = before["annotations"]
    after_annotations = after["annotations"]

    def semantic_counts(annotations):
        def semantic_annotation(annotation):
            annotation_type = annotation["type"]
            # Leader routing is layout, not manufacturing meaning. The candidate is allowed
            # to replace a straight Leader with a RoutedLeader while preserving the same
            # label, ownership, and requirement identities.
            semantic_type = "Leader" if annotation_type.endswith("Leader") else annotation_type
            semantic = {"type": semantic_type, "label": annotation["label"]}
            for field in ("measurements", "satisfactions", "owners"):
                if field in annotation:
                    semantic[field] = annotation[field]
            return semantic

        return Counter(
            json.dumps(
                semantic_annotation(annotation),
                sort_keys=True,
                separators=(",", ":"),
            )
            for annotation in annotations.values()
        )

    before_semantics = semantic_counts(before_annotations)
    after_semantics = semantic_counts(after_annotations)

    def expand(delta):
        return [json.loads(item) for item, count in sorted(delta.items()) for _ in range(count)]

    before_blockers = Counter(before["blocker_identities"])
    after_blockers = Counter(after["blocker_identities"])
    introduced_blockers = sorted((after_blockers - before_blockers).elements())
    before_coverage = before["coverage"]
    after_coverage = after["coverage"]
    coverage_no_worse = (
        before_coverage["requirements"] == after_coverage["requirements"]
        and after_coverage["placed"] >= before_coverage["placed"]
        and after_coverage["missing"] <= before_coverage["missing"]
        and after_coverage["unsupported"] <= before_coverage["unsupported"]
        and after_coverage["unverifiable"] <= before_coverage["unverifiable"]
    )
    parity = {
        "missing": expand(before_semantics - after_semantics),
        "added": expand(after_semantics - before_semantics),
        "renamed_or_reordered": sorted(
            name
            for name in set(before_annotations) & set(after_annotations)
            if before_annotations[name] != after_annotations[name]
        ),
        "coverage_equal": before["coverage"] == after["coverage"],
        "drops_equal": before["drops"] == after["drops"],
        "coverage_no_worse": coverage_no_worse,
        "introduced_blockers": introduced_blockers,
        "candidate_interior_dimensions": after["interior_dimensions"],
    }
    parity["passed"] = (
        not any(
            (
                parity["missing"],
                parity["candidate_interior_dimensions"],
            )
        )
        and parity["coverage_no_worse"]
        and not parity["introduced_blockers"]
    )
    baseline_key = tuple(before["arrangement_quality"]["selection_key"])
    candidate_key = tuple(after["arrangement_quality"]["selection_key"])
    if not parity["passed"]:
        verdict = "ineligible"
    elif candidate_key < baseline_key:
        verdict = "candidate"
    elif baseline_key < candidate_key:
        verdict = "baseline"
    else:
        verdict = "tie"
    return {
        "baseline": baseline,
        "candidate": candidate,
        "parity": parity,
        "quality_comparison": {
            "verdict": verdict,
            "baseline_key": baseline_key,
            "candidate_key": candidate_key,
        },
    }


def _failed_candidate_comparison(baseline: dict, error: str) -> dict:
    """Keep a candidate build failure as corpus evidence instead of aborting the run."""
    baseline_key = tuple(baseline["manifest"]["arrangement_quality"]["selection_key"])
    return {
        "baseline": baseline,
        "candidate": {"mode": "candidate", "error": error},
        "parity": {
            "passed": False,
            "reason": "candidate_build_failed",
            "missing": [],
            "added": [],
            "renamed_or_reordered": [],
            "coverage_equal": False,
            "drops_equal": False,
            "candidate_interior_dimensions": [],
        },
        "quality_comparison": {
            "verdict": "ineligible",
            "baseline_key": baseline_key,
            "candidate_key": None,
        },
    }


def _parse_routes(value: str) -> set[tuple[str, str]]:
    if value == "none":
        return set()
    routes = set()
    for item in value.split(","):
        view, separator, side = item.partition("/")
        if not separator or not view or not side:
            raise ValueError(f"invalid corridor route {item!r}; expected view/side")
        routes.add((view, side))
    return routes


def _candidate_trial(args, baseline: dict, *, routes: str, output: Path) -> dict:
    try:
        candidate = _run_worker(
            args, "candidate", output, candidate_routes=routes
        )
    except RuntimeError as error:
        return _failed_candidate_comparison(baseline, str(error))
    return _compare(baseline, candidate)


def _trial_summary(name: str, routes: str, result: dict) -> dict:
    parity = result["parity"]
    quality = result["quality_comparison"]
    return {
        "name": name,
        "candidate_routes": routes,
        "verdict": quality["verdict"],
        "candidate_key": quality["candidate_key"],
        "semantic_parity": parity["passed"],
        "missing_annotations": len(parity["missing"]),
        "introduced_blockers": len(parity.get("introduced_blockers", ())),
        "candidate_error": result["candidate"].get("error"),
    }


def _prefer_candidate(first: dict, second: dict) -> dict:
    """Choose the best semantically eligible trial; never reward a dropped requirement."""

    rank = {"candidate": 0, "tie": 1, "baseline": 2, "ineligible": 3}

    def key(result):
        quality = result["quality_comparison"]
        return (
            rank[quality["verdict"]],
            tuple(quality["candidate_key"] or (float("inf"),)),
        )

    return min((first, second), key=key)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--page", default="A3")
    parser.add_argument("--scale", type=float, default=0.2)
    parser.add_argument("--title", default="CTC-01")
    parser.add_argument("--number", default="NIST-CTC-01")
    parser.add_argument("--formats", default="pdf,png")
    parser.add_argument("--arrangement", choices=("columns", "stacked-iso", "staggered-side"))
    parser.add_argument("--exterior-dimensions", action="store_true")
    parser.add_argument(
        "--candidate-routes",
        default=(
            "front/right,plan/right,front/left,plan/left,plan/above,front/above,"
            "front/below,plan/below,side/above,side/below,side/right,rear/right"
        ),
        help="comma-separated view/side corridors to cap, or 'none' to retain legacy depths",
    )
    parser.add_argument("--worker", action="store_true")
    parser.add_argument("--mode", choices=("baseline", "candidate"), default="baseline")
    args = parser.parse_args()
    if args.worker:
        return _worker(args)
    baseline = _run_worker(args, "baseline", args.output.with_name(args.output.name + "-baseline"))
    result = _candidate_trial(
        args,
        baseline,
        routes=args.candidate_routes,
        output=args.output.with_name(args.output.name + "-candidate"),
    )
    trials = [_trial_summary("planned", args.candidate_routes, result)]
    selected_trial = "planned"
    # Page and scale are fixed in this comparison. A defect-free baseline has
    # the minimum possible key, so another build cannot improve it.
    baseline_affected = any(result["quality_comparison"]["baseline_key"][:5])
    if (
        baseline_affected
        and result["quality_comparison"]["verdict"] != "candidate"
        and args.candidate_routes != "none"
    ):
        uncapped = _candidate_trial(
            args,
            baseline,
            routes="none",
            output=args.output.with_name(args.output.name + "-candidate-uncapped"),
        )
        trials.append(_trial_summary("legacy-depth", "none", uncapped))
        if _prefer_candidate(result, uncapped) is uncapped:
            result = uncapped
            selected_trial = "legacy-depth"
    result["candidate_trials"] = trials
    result["selected_candidate_trial"] = selected_trial
    print(json.dumps(result, indent=2, sort_keys=True))
    return int(not result["parity"]["passed"])


if __name__ == "__main__":
    raise SystemExit(main())
