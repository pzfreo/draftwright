#!/usr/bin/env python3
"""Run an explicit pull-request, full, or scheduled test manifest."""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

import pytest

ROOT = Path(__file__).resolve().parent.parent
TESTS = ROOT / "tests"
sys.path.insert(0, str(TESTS))

from _tier_manifest import (  # noqa: E402
    FULL_EXPRESSION,
    SCHEDULED_EXPRESSION,
    pr_modules,
)


def _git_paths(*arguments: str) -> set[str]:
    result = subprocess.run(
        ["git", *arguments],
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        check=True,
    )
    return {line for line in result.stdout.splitlines() if line}


def changed_paths(base: str) -> list[str]:
    """Return every committed and local path the PR selector must account for."""
    committed = _git_paths("diff", "--name-only", "--diff-filter=ACMRD", f"{base}...HEAD")
    staged = _git_paths("diff", "--cached", "--name-only", "--diff-filter=ACMRD")
    unstaged = _git_paths("diff", "--name-only", "--diff-filter=ACMRD")
    untracked = _git_paths("ls-files", "--others", "--exclude-standard")
    return sorted(committed | staged | unstaged | untracked)


def _run_isolated_tests(pytest_args: list[str]) -> int:
    """Collect once, then give each selected test a fresh pytest process.

    OpenCascade retains substantial native state after dense real-part builds.  A serial xdist
    worker and an in-process ``pytest.main`` both retain that state across modules, eventually
    exhausting a hosted runner.  Exact node ids preserve marker, keyword, and pytest-split
    selection while process boundaries release the kernel state.  Test-level boundaries are
    intentional: the densest standards module can exhaust a hosted runner by itself.
    """
    collected = subprocess.run(
        [sys.executable, "-m", "pytest", *pytest_args, "--collect-only", "-q"],
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    if collected.returncode:
        sys.stdout.write(collected.stdout)
        return collected.returncode

    nodeids: list[str] = []
    for line in collected.stdout.splitlines():
        nodeid = line.strip()
        if "::" not in nodeid or ".py" not in nodeid:
            continue
        nodeids.append(nodeid)
    if not nodeids:
        sys.stdout.write(collected.stdout)
        return 5

    failed = False
    for index, nodeid in enumerate(nodeids, start=1):
        print(
            f"\n=== isolated scheduled test {index}/{len(nodeids)}: {nodeid} ===",
            flush=True,
        )
        completed = subprocess.run(
            [
                sys.executable,
                "-m",
                "pytest",
                nodeid,
                "-m",
                SCHEDULED_EXPRESSION,
                "-n",
                "0",
                "--timeout=600",
            ],
            cwd=ROOT,
        )
        failed |= completed.returncode != 0
    return int(failed)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("tier", choices=("pr", "full", "scheduled"))
    parser.add_argument("--base", default="origin/main", help="merge base for PR selection")
    parser.add_argument("--workers", default="auto", help="pytest-xdist worker count")
    parser.add_argument("--selection", help="additional marker expression within the tier")
    parser.add_argument(
        "--isolate-tests",
        action="store_true",
        help="run each selected scheduled test in a fresh process",
    )
    options, pytest_args = parser.parse_known_args(argv)

    common = ["-n", options.workers, "--dist", "loadscope"]
    if options.tier == "pr":
        paths = changed_paths(options.base)
        modules = pr_modules(TESTS, paths)
        print(
            f"PR tier: {len(modules)} modules selected from {len(paths)} changed paths",
            flush=True,
        )
        args = [*(str(TESTS / module) for module in modules), "-m", FULL_EXPRESSION]
    elif options.tier == "full":
        args = [str(TESTS), "-m", FULL_EXPRESSION]
    else:
        expression = SCHEDULED_EXPRESSION
        if options.selection:
            expression = f"({expression}) and ({options.selection})"
        args = [str(TESTS), "-m", expression]
        # Dense STEP builds take about 320 s alone and can take longer when the
        # scheduled workers contend for CPU. Keep this tier bounded without making
        # the fast and full feedback loops tolerate a ten-minute hang.
        common.append("--timeout=600")
    resolved = [*args, *common, *pytest_args]
    if options.tier == "scheduled" and options.isolate_tests:
        return _run_isolated_tests(resolved)
    return pytest.main(resolved)


if __name__ == "__main__":
    raise SystemExit(main())
