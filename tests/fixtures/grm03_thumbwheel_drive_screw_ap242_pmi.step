#2016=PROPERTY_DEFINITION('manufacturing requirement','general tolerances',#5);
#2017=PROPERTY_DEFINITION_REPRESENTATION(#2016,#2015);
#2018=DESCRIPTIVE_REPRESENTATION_ITEM('datum scheme','Datum A is the axis derived from DIA 5; datum B is the DIA 10-to-DIA 5 shoulder face');
#2019=REPRESENTATION('datum scheme requirement',(#2018),#769);
#2020=PROPERTY_DEFINITION('manufacturing requirement','datum scheme',#5);
