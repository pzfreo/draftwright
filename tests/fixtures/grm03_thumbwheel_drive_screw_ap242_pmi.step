#2002=DESCRIPTIVE_REPRESENTATION_ITEM('internal thread','M2 x 0.4-6H RH, 6 mm minimum full thread; DIA 1.6 tapping drill x 8 mm full-diameter depth; conventional 118 degree drill point');
#2003=REPRESENTATION('internal thread requirement',(#2002),#769);
#2004=PROPERTY_DEFINITION('manufacturing requirement','internal thread',#5);
#2005=PROPERTY_DEFINITION_REPRESENTATION(#2004,#2003);
#2006=DESCRIPTIVE_REPRESENTATION_ITEM('knurl','Straight knurl, 1.0 mm pitch, full width between C0.3 chamfers, DIA 10 mm maximum after knurling; cut or formed process permitted');
#2007=REPRESENTATION('knurl requirement',(#2006),#769);
#2008=PROPERTY_DEFINITION('manufacturing requirement','knurl',#5);
#2009=PROPERTY_DEFINITION_REPRESENTATION(#2008,#2007);
#2010=DESCRIPTIVE_REPRESENTATION_ITEM('surface texture','Ra 3.2 um unless otherwise specified');
#2011=REPRESENTATION('surface texture requirement',(#2010),#769);
#2012=PROPERTY_DEFINITION('manufacturing requirement','surface texture',#5);
#2013=PROPERTY_DEFINITION_REPRESENTATION(#2012,#2011);
#2014=DESCRIPTIVE_REPRESENTATION_ITEM('general tolerances','ISO 2768-m; dimensioning and tolerancing per ISO GPS');
